# Copy to .env.local and fill in. `npm run dev` creates a temporary Neon database (and writes
# DATABASE_URL) if none is set.

# Postgres: the direct URL is used by migrations (drizzle-kit), the pooled one by the app.
DATABASE_URL=
DATABASE_URL_POOLED=

# Neon Auth. The browser needs the same URL; it is built into the client at `npm run build`.
NEON_AUTH_BASE_URL=
VITE_NEON_AUTH_URL=${NEON_AUTH_BASE_URL}

# Production behind a proxy (Fly, Render, Railway…): read the player's address from
# X-Forwarded-For for the per-address connection limit.
# TRUST_PROXY=1
